gth1":33,"diffs":[[1,"    upper = line.upper()\n"]]},{"start1":3424,"length1":20,"diffs":[[1,"        help()\n"]]},{"start1":3466,"length1":42,"diffs":[[1,"        serial.write_line(\"MicroSLM\")\n"]]},{"start1":3822,"length1":56,"diffs":[[1,""]]},{"start1":3823,"length1":110,"diffs":[[1,"    elif upper[:6] == \"LEARN \":\n        learn(line[6:])\n"]]},{"start1":3988,"length1":136,"diffs":[[1,"    elif upper[:4] == \"GEN \":\n        result = generate(line[4:], GEN_LENGTH)\n"]]},{"start1":4155,"length1":1,"diffs":[[1,""]]},{"start1":4214,"length1":83,"diffs":[[1,"    line = serial.read_until(\"\\n\")\n    command(line)\n"]]},{"start1":4268,"length1":25,"diffs":[[1,""]]},{"start1":4269,"length1":146,"diffs":[[1,""]]},{"start1":4319,"length1":1,"diffs":[[1,""]]},{"start1":4349,"length1":1,"diffs":[[1,""]]},{"start1":4484,"length1":1,"diffs":[[1,""]]},{"start1":4557,"length1":1,"diffs":[[1,""]]},{"start1":4595,"length1":1,"diffs":[[1,""]]},{"start1":4632,"length1":137,"diffs":[[1,"# Initialize USB serial\n"]]},{"start1":4729,"length1":0,"diffs":[[1,"# Train initial model\n"]]},{"start1":4782,"length1":203,"diffs":[[1,"serial.write_line(\"MicroSLM MakeCode Python\")\nserial.write_line(\"micro:bit V2 ready.\")\n"]]},{"start1":4914,"length1":50,"diffs":[[1,"serial.write_line(\"Training transitions: \" + str(trained[0]))\n"]]},{"start1":4977,"length1":91,"diffs":[[1,"# Register controls\nserial.on_data_received(\"\\n\", serial_received)\n"]]},{"start1":5180,"length1":41,"diffs":[[1,"basic.show_icon(IconNames.SMALL_DIAMOND)"]]}]}]},{"timestamp":1794761533183,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":84,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>"]]}]}]},{"timestamp":1794762653139,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":244,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1794760755599,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"AI\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1794762653139,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"","README.md":"","main.py":"\n# ============================================================\n# MicroSLM 1.0\n# Small Language Model\n# Microsoft MakeCode Python\n# BBC micro:bit V2\n# ============================================================\n\nALPHABET = \"abcdefghijklmnopqrstuvwxyz .,!?'-\"\nVOCAB = ALPHABET.length\n\nCONTEXTS = 64\nMAX_COUNT = 250\nGEN_LENGTH = 80\n\nSTARTER_TEXT = (\n    \"hello there. the little robot is learning to talk. \"\n    \"it reads text and predicts what character comes next. \"\n    \"a small language model learns patterns from examples. \"\n    \"the quick brown fox jumps over the lazy dog. \"\n    \"once upon a time a curious mouse explored a quiet forest. \"\n    \"the mouse found a tiny house beside a river. \"\n    \"the sun was bright and the birds were singing. \"\n    \"machines can learn from data and generate new sentences. \"\n    \"learning takes practice patience and many examples. \"\n    \"the robot likes science computers and making things. \"\n    \"the world is full of interesting ideas and questions. \"\n    \"a tiny computer can learn simple patterns. \"\n    \"the machine studies language and predicts the future. \"\n)\n\n# ============================================================\n# MODEL STORAGE\n# ============================================================\n\ncounts = []\n\nfor i in range(CONTEXTS * VOCAB):\n    counts.append(0)\n\ntrained = [0]\n\n\n# ============================================================\n# TOKENIZER\n# ============================================================\n\ndef char_index(ch):\n    return ALPHABET.index_of(ch.to_lower_case()) if ALPHABET.index_of(ch.to_lower_case()) >= 0 else ALPHABET.index_of(\" \")\n\n\ndef normalize_char(ch):\n    return ALPHABET.char_at(char_index(ch))\n\n\ndef get_context(a, b):\n    return (\n        char_index(a) * VOCAB +\n        char_index(b)\n    ) % CONTEXTS\n\n\n# ============================================================\n# TRAINING\n# ============================================================\n\ndef reset_model():\n    for i in range(counts.length):\n        counts[i] = 0\n\n    trained[0] = 0\n\n\ndef learn(text):\n    text = text.to_lower_case()\n\n    a = \" \"\n    b = \" \"\n\n    for i in range(text.length):\n        ch = normalize_char(text.char_at(i))\n\n        context = get_context(a, b)\n        next_char = char_index(ch)\n\n        index = context * VOCAB + next_char\n\n        if counts[index] < MAX_COUNT:\n            counts[index] = counts[index] + 1\n\n        trained[0] = trained[0] + 1\n\n        a = b\n        b = ch\n\n\ndef train():\n    reset_model()\n    learn(STARTER_TEXT)\n\n\n# ============================================================\n# NEXT CHARACTER PREDICTION\n# ============================================================\n\ndef predict(a, b):\n    context = get_context(a, b)\n    row = context * VOCAB\n\n    total = 0\n\n    for i in range(VOCAB):\n        total = total + counts[row + i]\n\n    if total == 0:\n        return ALPHABET.char_at(\n            Math.random_range(0, VOCAB - 1)\n        )\n\n    # Weighted random sampling\n    pick = Math.random_range(1, total)\n\n    for i in range(VOCAB):\n        pick = pick - counts[row + i]\n\n        if pick <= 0:\n            return ALPHABET.char_at(i)\n\n    return \" \"\n\n\n# ============================================================\n# TEXT GENERATION\n# ============================================================\n\ndef generate(prompt, amount):\n    prompt = prompt.to_lower_case()\n\n    a = \" \"\n    b = \" \"\n    output = \"\"\n\n    for i in range(prompt.length):\n        ch = normalize_char(prompt.char_at(i))\n\n        output = output + ch\n\n        a = b\n        b = ch\n\n    if output == \"\":\n        output = \"the \"\n        a = \"h\"\n        b = \" \"\n\n    for i in range(amount):\n        next_char = predict(a, b)\n\n        output = output + next_char\n\n        a = b\n        b = next_char\n\n    return output\n\n\n# ============================================================\n# SERIAL INTERFACE\n# ============================================================\n\ndef show_help():\n    serial.write_line(\"\")\n    serial.write_line(\"=== MicroSLM ===\")\n    serial.write_line(\"GEN prompt\")\n    serial.write_line(\"LEARN text\")\n    serial.write_line(\"RESET\")\n    serial.write_line(\"INFO\")\n    serial.write_line(\"HELP\")\n    serial.write_line(\"\")\n\n\ndef handle_command(line):\n    line = line.replace(\"\\r\", \"\")\n    line = line.replace(\"\\n\", \"\")\n\n    if line.length == 0:\n        return\n\n    upper = line.to_upper_case()\n\n    if upper == \"HELP\":\n        show_help()\n\n    elif upper == \"INFO\":\n        serial.write_line(\"MicroSLM 1.0\")\n        serial.write_line(\"Model: hashed trigram\")\n        serial.write_line(\"Vocabulary: \" + str(VOCAB))\n        serial.write_line(\"Contexts: \" + str(CONTEXTS))\n        serial.write_line(\"Training transitions: \" + str(trained[0]))\n\n    elif upper == \"RESET\":\n        train()\n        serial.write_line(\"Model reset.\")\n        serial.write_line(\"Starter training complete.\")\n\n    elif upper.substr(0, 6) == \"LEARN \":\n        text = line.substr(6, line.length - 6)\n\n        learn(text)\n\n        serial.write_line(\"Learned new text.\")\n        serial.write_line(\"Transitions: \" + str(trained[0]))\n\n    elif upper.substr(0, 4) == \"GEN \":\n        prompt = line.substr(4, line.length - 4)\n\n        result = generate(prompt, GEN_LENGTH)\n\n        serial.write_line(result)\n\n    else:\n        result = generate(line, GEN_LENGTH)\n\n        serial.write_line(result)\n\n\ndef serial_received():\n    line = serial.read_until(\n        serial.delimiters(Delimiters.NEW_LINE)\n    )\n\n    handle_command(line)\n\n\n# ============================================================\n# BUTTON CONTROLS\n# ============================================================\n\ndef button_a():\n    result = generate(\"the \", 40)\n\n    serial.write_line(result)\n\n    basic.show_icon(IconNames.HAPPY)\n\n\ndef button_b():\n    serial.write_line(\n        \"Training transitions: \" + str(trained[0])\n    )\n\n    basic.show_number(trained[0] % 10000)\n\n\ndef button_ab():\n    train()\n\n    serial.write_line(\"Model reset.\")\n\n    basic.show_icon(IconNames.YES)\n\n\n# ============================================================\n# STARTUP\n# ============================================================\n\nserial.redirect_to_usb()\nserial.set_baud_rate(BaudRate.BAUD_RATE115200)\n\ntrain()\n\nserial.write_line(\"\")\nserial.write_line(\"========================\")\nserial.write_line(\"MicroSLM 1.0\")\nserial.write_line(\"MakeCode Python\")\nserial.write_line(\"micro:bit V2 ready\")\nserial.write_line(\"========================\")\nserial.write_line(\"Type HELP for commands.\")\nserial.write_line(\"Training: \" + str(trained[0]))\n\nserial.on_data_received(\n    serial.delimiters(Delimiters.NEW_LINE),\n    serial_received\n)\n\ninput.on_button_pressed(Button.A, button_a)\ninput.on_button_pressed(Button.B, button_b)\ninput.on_button_pressed(Button.AB, button_ab)\n\nbasic.show_icon(IconNames.SMALL_DIAMOND)\n","pxt.json":"{\n    \"name\": \"AI\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"pyprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794762653145}