{"entries":[{"timestamp":1794760755600,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":185,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":46,"diffs":[[1,"\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":198,"length1":39,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":225,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"main.py","value":"# MicroSLM — MakeCode Python\n# BBC micro:bit V2\n#\n# Commands over USB serial:\n# GEN prompt\n# LEARN text\n# RESET\n# INFO\n# HELP\n#\n# Character-level hashed-trigram language model.\n# Learns character transition patterns and generates text.\n\nALPHABET = \"abcdefghijklmnopqrstuvwxyz .,!?'-\"\nVOCAB = len(ALPHABET)\nCONTEXTS = 64\nMAX_COUNT = 250\nGEN_LENGTH = 80\n\nSTARTER_TEXT = (\n    \"hello there. the little robot is learning to talk. \"\n    \"it reads text and predicts what character comes next. \"\n    \"a small language model learns patterns from examples. \"\n    \"the quick brown fox jumps over the lazy dog. \"\n    \"once upon a time a curious mouse explored a quiet forest. \"\n    \"the mouse found a tiny house beside a river. \"\n    \"the sun was bright and the birds were singing. \"\n    \"machines can learn from data and generate new sentences. \"\n    \"learning takes practice, patience, and many examples. \"\n    \"the robot likes science, computers, and making things. \"\n    \"what is a language model? it is a program that predicts text. \"\n    \"the world is full of interesting ideas and questions. \"\n    \"a tiny computer can still learn simple patterns. \"\n)\n\n# Model storage: 64 contexts x 34 possible next characters\ncounts = [0] * (CONTEXTS * VOCAB)\n\n# Training statistics\ntrained = [0]\n\n\ndef char_index(ch):\n    i = ALPHABET.find(ch.lower())\n    if i < 0:\n        return ALPHABET.find(\" \")\n    return i\n\n\ndef get_context(a, b):\n    return (\n        char_index(a) * VOCAB +\n        char_index(b)\n    ) % CONTEXTS\n\n\ndef reset_model():\n    for i in range(len(counts)):\n        counts[i] = 0\n    trained[0] = 0\n\n\ndef learn(text):\n    text = text.lower()\n\n    for i in range(len(text)):\n        if i >= 2:\n            a = text[i - 2]\n        else:\n            a = \" \"\n\n        if i >= 1:\n            b = text[i - 1]\n        else:\n            b = \" \"\n\n        context = get_context(a, b)\n        next_char = char_index(text[i])\n\n        index = context * VOCAB + next_char\n\n        if counts[index] < MAX_COUNT:\n            counts[index] += 1\n\n        trained[0] += 1\n\n\ndef train():\n    reset_model()\n    learn(STARTER_TEXT)\n\n\ndef predict(a, b):\n    context = get_context(a, b)\n    row = context * VOCAB\n\n    total = 0\n\n    for i in range(VOCAB):\n        total += counts[row + i]\n\n    if total == 0:\n        return ALPHABET[Math.random_range(0, VOCAB - 1)]\n\n    pick = Math.random_range(1, total)\n\n    for i in range(VOCAB):\n        pick -= counts[row + i]\n\n        if pick <= 0:\n            return ALPHABET[i]\n\n    return \" \"\n\n\ndef generate(prompt, length):\n    prompt = prompt.lower()\n\n    if len(prompt) == 0:\n        prompt = \"the \"\n\n    output = prompt\n\n    if len(prompt) >= 2:\n        a = prompt[-2]\n        b = prompt[-1]\n    elif len(prompt) == 1:\n        a = \" \"\n        b = prompt[0]\n    else:\n        a = \" \"\n        b = \" \"\n\n    for i in range(length):\n        next_char = predict(a, b)\n\n        output += next_char\n\n        a = b\n        b = next_char\n\n    return output\n\n\ndef help():\n    serial.write_line(\"\")\n    serial.write_line(\"MicroSLM commands:\")\n    serial.write_line(\"GEN prompt\")\n    serial.write_line(\"LEARN text\")\n    serial.write_line(\"RESET\")\n    serial.write_line(\"INFO\")\n    serial.write_line(\"HELP\")\n    serial.write_line(\"\")\n\n\ndef command(line):\n    line = line.replace(\"\\r\", \"\")\n    line = line.replace(\"\\n\", \"\")\n\n    if len(line) == 0:\n        return\n\n    upper = line.upper()\n\n    if upper == \"HELP\":\n        help()\n\n    elif upper == \"INFO\":\n        serial.write_line(\"MicroSLM\")\n        serial.write_line(\"Model: hashed trigram\")\n        serial.write_line(\"Vocabulary: \" + str(VOCAB))\n        serial.write_line(\"Contexts: \" + str(CONTEXTS))\n        serial.write_line(\"Training transitions: \" + str(trained[0]))\n\n    elif upper == \"RESET\":\n        train()\n        serial.write_line(\"Model reset.\")\n\n    elif upper[:6] == \"LEARN \":\n        learn(line[6:])\n        serial.write_line(\"Learned new text.\")\n        serial.write_line(\"Transitions: \" + str(trained[0]))\n\n    elif upper[:4] == \"GEN \":\n        result = generate(line[4:], GEN_LENGTH)\n        serial.write_line(result)\n\n    else:\n        result = generate(line, GEN_LENGTH)\n        serial.write_line(result)\n\n\ndef serial_received():\n    line = serial.read_until(\"\\n\")\n    command(line)\n\n\ndef button_a():\n    result = generate(\"the \", 40)\n    serial.write_line(result)\n    basic.show_icon(IconNames.HAPPY)\n\n\ndef button_b():\n    serial.write_line(\n        \"Training transitions: \" + str(trained[0])\n    )\n    basic.show_number(trained[0] % 10000)\n\n\ndef button_ab():\n    train()\n    serial.write_line(\"Model reset.\")\n    basic.show_icon(IconNames.YES)\n\n\n# Initialize USB serial\nserial.redirect_to_usb()\nserial.set_baud_rate(BaudRate.BAUD_RATE115200)\n\n# Train initial model\ntrain()\n\nserial.write_line(\"\")\nserial.write_line(\"MicroSLM MakeCode Python\")\nserial.write_line(\"micro:bit V2 ready.\")\nserial.write_line(\"Type HELP for commands.\")\nserial.write_line(\"Training transitions: \" + str(trained[0]))\n\n# Register controls\nserial.on_data_received(\"\\n\", serial_received)\n\ninput.on_button_pressed(Button.A, button_a)\ninput.on_button_pressed(Button.B, button_b)\ninput.on_button_pressed(Button.AB, button_ab)\n\nbasic.show_icon(IconNames.SMALL_DIAMOND)"}]},{"timestamp":1794761273235,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":3201,"diffs":[[1,"basic.forever(function on_forever() {\n"]]},{"start1":43,"length1":3592,"diffs":[[1,""]]},{"start1":46,"length1":506,"diffs":[[1,""]]}]},{"type":"edited","filename":"main.py","patch":[{"start1":0,"length1":130,"diffs":[[1,"# MicroSLM — MakeCode Python\n"]]},{"start1":48,"length1":63,"diffs":[[1,"#\n# Commands over USB serial:\n# GEN prompt\n# LEARN text\n# RESET\n# INFO\n# HELP\n#\n# Character-level hashed-trigram language model.\n# Learns character transition patterns and generates text.\n"]]},{"start1":284,"length1":25,"diffs":[[1,"VOCAB = len(ALPHABET)\n"]]},{"start1":837,"length1":119,"diffs":[[1,"    \"learning takes practice, patience, and many examples. \"\n    \"the robot likes science, computers, and making things. \"\n    \"what is a language model? it is a program that predicts text. \"\n"]]},{"start1":1090,"length1":111,"diffs":[[1,"    \"a tiny computer can still learn simple patterns. \"\n"]]},{"start1":1149,"length1":142,"diffs":[[1,"# Model storage: 64 contexts x 34 possible next characters\ncounts = [0] * (CONTEXTS * VOCAB)\n"]]},{"start1":1243,"length1":69,"diffs":[[1,"# Training statistics\n"]]},{"start1":1281,"length1":139,"diffs":[[1,""]]},{"start1":1301,"length1":123,"diffs":[[1,"    i = ALPHABET.find(ch.lower())\n    if i < 0:\n        return ALPHABET.find(\" \")\n    return i\n"]]},{"start1":1398,"length1":70,"diffs":[[1,""]]},{"start1":1507,"length1":138,"diffs":[[1,""]]},{"start1":1526,"length1":35,"diffs":[[1,"    for i in range(len(counts)):\n"]]},{"start1":1581,"length1":1,"diffs":[[1,""]]},{"start1":1619,"length1":32,"diffs":[[1,"    text = text.lower()\n"]]},{"start1":1